# ── Required: eBay API credentials ───────────────────────────────────────────
# Create an app at https://developer.ebay.com/my/keys
EBAY_APP_ID='your-ebay-app-id'

# Base64-encoded "AppID:CertID" — used for OAuth client_credentials + user tokens
# Generate: Buffer.from('AppID:CertID').toString('base64')
EBAY_OAUTH_CREDENTIALS='base64-encoded-appid-colon-certid'

# ── Set automatically by /auth/ebay OAuth flow ────────────────────────────────
EBAY_OAUTH_USER_TOKEN=''
EBAY_OAUTH_REFRESH_TOKEN=''
EBAY_OAUTH_USER_TOKEN_EXPIRY=''

# ── Optional: Amazon product lookup ──────────────────────────────────────────
# ScraperAPI (free tier: 1000 req/mo) — bypasses Amazon bot blocks
# Sign up: https://www.scraperapi.com
SCRAPER_API_KEY=''

# Amazon Product Advertising API (PA API) — richer data than scraping
# Requires an active Associates account: https://affiliate-program.amazon.com
AMAZON_ACCESS_KEY=''
AMAZON_SECRET_KEY=''
AMAZON_ASSOCIATE_TAG=''

# ── Optional: Image hosting ───────────────────────────────────────────────────
# ImgBB free tier: unlimited uploads, permanent hosting
# Sign up: https://imgbb.com — API key at https://api.imgbb.com
IMGBB_API_KEY=''

# ── Optional: Server ─────────────────────────────────────────────────────────
PORT=3000

# ── Optional: Scheduled jobs ─────────────────────────────────────────────────
# How often (minutes) to run the auto-repricer. 0 = disabled.
REPRICER_INTERVAL_MINUTES=1440

# How often (minutes) to run the stock checker. 0 = disabled.
STOCK_CHECK_INTERVAL_MINUTES=360

# How often (minutes) to run the price watcher. 0 = disabled.
PRICE_WATCH_INTERVAL_MINUTES=360
